{
  "openapi": "3.1.0",
  "info": {
    "title": "AI Code Review Agent",
    "description": "Autonomous Code Review and Refactoring Agent using LangGraph",
    "version": "1.0.0"
  },
  "paths": {
    "/api/webhooks/github": {
      "post": {
        "summary": "Github Webhook",
        "operationId": "github_webhook_api_webhooks_github_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GitHubWebhook"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/reviews/{thread_id}/approve": {
      "post": {
        "summary": "Approve Review",
        "operationId": "approve_review_api_reviews__thread_id__approve_post",
        "parameters": [
          {
            "name": "thread_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Thread Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ReviewDecision"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "GitHubWebhook": {
        "properties": {
          "action": {
            "type": "string",
            "title": "Action"
          },
          "pull_request": {
            "additionalProperties": true,
            "type": "object",
            "title": "Pull Request"
          }
        },
        "type": "object",
        "required": [
          "action",
          "pull_request"
        ],
        "title": "GitHubWebhook"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "ReviewDecision": {
        "properties": {
          "approved": {
            "type": "boolean",
            "title": "Approved"
          },
          "feedback": {
            "type": "string",
            "title": "Feedback",
            "default": ""
          }
        },
        "type": "object",
        "required": [
          "approved"
        ],
        "title": "ReviewDecision"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}